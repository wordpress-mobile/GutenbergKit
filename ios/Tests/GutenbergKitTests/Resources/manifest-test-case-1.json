{
  "scripts": {
    "jetpack-forms-blocks": {
      "src": "http://localhost/wp-content/plugins/jetpack/forms/dist/blocks/view.js",
      "deps": ["wp-element", "wp-blocks"],
      "version": "1.0.0",
      "in_footer": true
    },
    "jetpack-contact-form": {
      "src": "http://localhost/wp-content/plugins/jetpack/modules/contact-form/js/editor.js",
      "deps": ["jetpack-forms-blocks"],
      "version": "2.0.0",
      "in_footer": false
    },
    "jetpack-videopress": {
      "src": "http://localhost/wp-content/plugins/jetpack/modules/videopress/js/videopress.js",
      "deps": [],
      "version": "3.0.0",
      "in_footer": true
    }
  },
  "styles": {
    "jetpack-forms-blocks-css": {
      "src": "http://localhost/wp-content/plugins/jetpack/forms/dist/blocks/editor.css",
      "deps": [],
      "version": "1.0.0",
      "media": "all"
    },
    "jetpack-contact-form-css": {
      "src": "http://localhost/wp-content/plugins/jetpack/modules/contact-form/css/editor.css",
      "deps": ["jetpack-forms-blocks-css"],
      "version": "2.0.0",
      "media": "screen"
    }
  },
  "inline_scripts": {
    "before": {
      "jetpack-forms-blocks": "window.JetpackFormsConfig = { enabled: true };"
    },
    "after": {
      "jetpack-contact-form": "console.log('Contact form loaded');"
    }
  },
  "inline_styles": {
    "before": {
      "jetpack-forms-blocks-css": ":root { --jetpack-form-color: blue; }"
    },
    "after": {}
  }
}
