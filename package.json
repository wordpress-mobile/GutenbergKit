{
	"name": "gutenberg-kit",
	"private": true,
	"homepage": "https://github.com/wordpress-mobile/GutenbergKit",
	"version": "0.20.0-alpha.1",
	"type": "module",
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.18.0"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.16.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"clean": "npm run clean:dist && npm run clean:l10n",
		"clean:dist": "rm -rf dist",
		"clean:l10n": "rm -rf src/translations",
		"dev": "vite --host",
		"dev:force": "vite --host --force",
		"dev:tools": "react-devtools",
		"build": "vite --emptyOutDir build",
		"check:wp-packages": "node bin/check-wordpress-package-duplicates.js",
		"fetch-translations": "node bin/fetch-translations.js",
		"format": "prettier --write . --log-level warn",
		"format:check": "prettier --check .",
		"generate-version": "node bin/generate-version.js",
		"lint:js": "eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:js:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
		"postinstall": "patch-package --error-on-warn && npm run generate-version",
		"preview": "vite preview --host",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"wp-env": "wp-env"
	},
	"dependencies": {
		"@wordpress/a11y": "^5.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/autop": "^5.0.0",
		"@wordpress/base-styles": "^14.0.0",
		"@wordpress/blob": "^5.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/block-library": "^12.0.0",
		"@wordpress/block-serialization-default-parser": "^6.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/commands": "^2.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/data-controls": "^5.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/deprecated": "^5.0.0",
		"@wordpress/dom": "^5.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/edit-post": "^9.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/escape-html": "^4.0.0",
		"@wordpress/format-library": "^6.0.0",
		"@wordpress/global-styles-engine": "^2.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/html-entities": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/is-shallow-equal": "^6.0.0",
		"@wordpress/keyboard-shortcuts": "^6.0.0",
		"@wordpress/keycodes": "^5.0.0",
		"@wordpress/media-utils": "^6.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/patterns": "^3.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/preferences": "^5.0.0",
		"@wordpress/preferences-persistence": "^3.0.0",
		"@wordpress/primitives": "^5.0.0",
		"@wordpress/priority-queue": "^4.0.0",
		"@wordpress/private-apis": "^3.0.0",
		"@wordpress/redux-routine": "^6.0.0",
		"@wordpress/rich-text": "^8.0.0",
		"@wordpress/router": "^2.0.0",
		"@wordpress/server-side-render": "^7.0.0",
		"@wordpress/shortcode": "^5.0.0",
		"@wordpress/style-engine": "^3.0.0",
		"@wordpress/theme": "^3.0.0",
		"@wordpress/token-list": "^4.0.0",
		"@wordpress/undo-manager": "^2.0.0",
		"@wordpress/upload-media": "^0.43.0",
		"@wordpress/url": "^5.0.0",
		"@wordpress/viewport": "^7.0.0",
		"@wordpress/warning": "^4.0.0",
		"@wordpress/widgets": "^5.0.0",
		"@wordpress/wordcount": "^5.0.0",
		"clsx": "^2.1.1",
		"jquery": "^3.7.1",
		"lodash": "^4.18.1",
		"moment": "^2.31.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.1.2",
		"@wordpress/dependency-extraction-webpack-plugin": "^7.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/prettier-config": "^4.55.0",
		"ajv": "^8.20.0",
		"eslint": "^10.13.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"magic-string": "^1.4.2",
		"patch-package": "^8.0.1",
		"prettier": "npm:wp-prettier@^3.0.3",
		"react-devtools": "^8.0.0",
		"react-devtools-core": "^8.0.0",
		"sass-embedded": "^1.105.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.4"
	},
	"overrides": {
		"ws": "8.21.0",
		"react-devtools-core": {
			"ws": "7.5.13"
		},
		"@wordpress/env": {
			"qs": "6.16.1"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "9.0.9"
		},
		"@wordpress/babel-preset-default": {
			"@babel/core": "7.29.7"
		},
		"eslint-plugin-import": {
			"eslint": "$eslint"
		}
	},
	"allowScripts": {
		"electron@23.3.13": true,
		"unrs-resolver@1.11.1": true,
		"@parcel/watcher@2.5.0": true,
		"fsevents@2.3.3": true,
		"fs-ext-extra-prebuilt@2.2.16": true
	}
}
