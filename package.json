{
	"name": "gutenberg-kit",
	"private": true,
	"homepage": "https://github.com/wordpress-mobile/GutenbergKit",
	"version": "0.20.0-alpha.0",
	"type": "module",
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.18.0"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.16.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"clean": "npm run clean:dist && npm run clean:l10n",
		"clean:dist": "rm -rf dist",
		"clean:l10n": "rm -rf src/translations",
		"dev": "vite --host",
		"dev:force": "vite --host --force",
		"dev:tools": "react-devtools",
		"build": "vite --emptyOutDir build",
		"check:wp-packages": "node bin/check-wordpress-package-duplicates.js",
		"format": "prettier --write .",
		"generate-version": "node bin/generate-version.js",
		"lint:js": "eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:js:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
		"postinstall": "patch-package --error-on-warn && npm run generate-version",
		"prep-translations": "node bin/prep-translations.js",
		"preview": "vite preview --host",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"wp-env": "wp-env"
	},
	"dependencies": {
		"@wordpress/a11y": "^4.55.0",
		"@wordpress/api-fetch": "^7.55.0",
		"@wordpress/autop": "^4.55.0",
		"@wordpress/base-styles": "^13.1.0",
		"@wordpress/blob": "^4.55.0",
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/block-library": "^11.0.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/commands": "^1.43.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/compose": "^8.8.0",
		"@wordpress/core-data": "^8.0.0",
		"@wordpress/data": "^10.42.0",
		"@wordpress/data-controls": "^4.55.0",
		"@wordpress/date": "^5.38.0",
		"@wordpress/deprecated": "^4.38.0",
		"@wordpress/dom": "^4.38.0",
		"@wordpress/dom-ready": "^4.38.0",
		"@wordpress/edit-post": "^8.55.0",
		"@wordpress/editor": "^15.0.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/escape-html": "^3.38.0",
		"@wordpress/format-library": "^5.55.0",
		"@wordpress/global-styles-engine": "^1.9.0",
		"@wordpress/hooks": "^4.38.0",
		"@wordpress/html-entities": "^4.38.0",
		"@wordpress/i18n": "^6.11.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/is-shallow-equal": "^5.38.0",
		"@wordpress/keyboard-shortcuts": "^5.38.0",
		"@wordpress/keycodes": "^4.38.0",
		"@wordpress/media-utils": "^5.38.0",
		"@wordpress/notices": "^5.38.0",
		"@wordpress/patterns": "^2.38.0",
		"@wordpress/plugins": "^7.38.0",
		"@wordpress/preferences": "^4.42.0",
		"@wordpress/preferences-persistence": "^2.55.0",
		"@wordpress/primitives": "^4.43.0",
		"@wordpress/priority-queue": "^3.38.0",
		"@wordpress/private-apis": "^1.38.0",
		"@wordpress/rich-text": "^7.42.0",
		"@wordpress/router": "^1.55.0",
		"@wordpress/server-side-render": "^6.14.0",
		"@wordpress/shortcode": "^4.38.0",
		"@wordpress/style-engine": "^2.43.0",
		"@wordpress/theme": "^2.1.0",
		"@wordpress/token-list": "^3.38.0",
		"@wordpress/url": "^4.42.0",
		"@wordpress/viewport": "^6.38.0",
		"@wordpress/warning": "^3.42.0",
		"@wordpress/widgets": "^4.38.0",
		"@wordpress/wordcount": "^4.42.0",
		"clsx": "^2.1.1",
		"jquery": "^3.7.1",
		"lodash": "^4.18.1",
		"moment": "^2.30.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.43.0",
		"@wordpress/env": "^11.2.0",
		"@wordpress/eslint-plugin": "^26.0.0",
		"@wordpress/prettier-config": "^4.55.0",
		"ajv": "^8.18.0",
		"eslint": "^10.10.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^16.5.0",
		"jsdom": "^29.0.2",
		"magic-string": "^1.3.1",
		"patch-package": "^8.0.1",
		"prettier": "npm:wp-prettier@^3.0.3",
		"react-devtools": "^8.0.0",
		"react-devtools-core": "^8.0.0",
		"sass-embedded": "^1.104.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"overrides": {
		"ws": "8.21.0",
		"react-devtools-core": {
			"ws": "7.5.13"
		},
		"@wordpress/env": {
			"qs": "6.15.2"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "9.0.9"
		},
		"@wordpress/babel-preset-default": {
			"@babel/core": "7.29.7"
		},
		"eslint-plugin-import": {
			"eslint": "$eslint"
		}
	},
	"allowScripts": {
		"electron@23.3.13": true,
		"fs-ext-extra-prebuilt@2.2.7": true,
		"unrs-resolver@1.11.1": true,
		"@parcel/watcher@2.5.0": true,
		"core-js": false,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true
	}
}
