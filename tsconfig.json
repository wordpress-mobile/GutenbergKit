{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*",
		"bin/**/*",
		"__mocks__/**/*",
		"*.config.js",
		"vitest.setup.js"
	]
}
